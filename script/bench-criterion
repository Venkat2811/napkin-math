#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

cd "${REPO_ROOT}"

if [ "$#" -gt 0 ]; then
  exec env RUSTFLAGS="${RUSTFLAGS:--C target-cpu=native}" cargo bench --bench napkin_math -- "$@"
else
  exec env RUSTFLAGS="${RUSTFLAGS:--C target-cpu=native}" cargo bench --bench napkin_math
fi

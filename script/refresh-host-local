#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
README_FILE="${REPO_ROOT}/README.md"
SOURCES_FILE="${REPO_ROOT}/host_local_sources.json"
START_MARKER="<!-- host-local:start -->"
END_MARKER="<!-- host-local:end -->"
TMP_RENDER="$(mktemp)"
TMP_README="$(mktemp)"
STRICT="${NAPKIN_STRICT_HOST_LOCAL_SOURCES:-0}"

cleanup() {
  rm -f "${TMP_RENDER}" "${TMP_README}"
}

trap cleanup EXIT

if ! command -v jq >/dev/null 2>&1; then
  echo "jq is required to refresh host-local provenance" >&2
  exit 1
fi

check_repo() {
  local key="$1"
  local repo_path expected_commit current_commit
  repo_path="$(jq -r --arg key "${key}" '.sources[$key].repo_path' "${SOURCES_FILE}")"
  expected_commit="$(jq -r --arg key "${key}" '.sources[$key].commit' "${SOURCES_FILE}")"

  if [ ! -d "${REPO_ROOT}/${repo_path}" ]; then
    echo "warning: companion repo ${repo_path} not found; skipping local commit check" >&2
    return 0
  fi

  current_commit="$(git -C "${REPO_ROOT}/${repo_path}" rev-parse --short HEAD)"
  if [ "${current_commit}" != "${expected_commit}" ]; then
    echo "warning: ${repo_path} is at ${current_commit}, expected ${expected_commit}" >&2
    if [ "${STRICT}" = "1" ]; then
      exit 1
    fi
  fi
}

check_repo "disruptor_rs"
check_repo "myelon"

"${SCRIPT_DIR}/render-host-local" > "${TMP_RENDER}"

awk -v start="${START_MARKER}" -v end="${END_MARKER}" -v repl="${TMP_RENDER}" '
  $0 == start {
    print
    while ((getline line < repl) > 0) {
      print line
    }
    close(repl)
    skip = 1
    next
  }
  $0 == end {
    skip = 0
  }
  !skip {
    print
  }
' "${README_FILE}" > "${TMP_README}"

mv "${TMP_README}" "${README_FILE}"
